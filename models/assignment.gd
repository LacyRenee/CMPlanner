class_name Assignment 
extends Resource

## Holds the title from the Resource Division List
@export var title : String = ""

## Tracks completion of the assignment 
@export var progress : ResourceData.progress

## The assigned start date
@export var start_date : String = ""

## The date the specified assignment was completed
@export var completed_date : String = ""

## User notes for the assignment
@export var notes : String = ""
