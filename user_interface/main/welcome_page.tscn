[gd_scene format=3 uid="uid://j534kdp8bf1u"]

[node name="WelcomePage" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"BackgroundPanel"

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 100
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 100
theme_override_constants/margin_bottom = 10

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2

[node name="LabelWelcomeHeader" type="RichTextLabel" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"HeaderLargeLabelDark"
text = "Welcome to your Charlotte Mason inspired home instruction Planner!"
fit_content = true
horizontal_alignment = 1

[node name="ControlSpacer" type="Control" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2

[node name="LabelWelcomeBody" type="RichTextLabel" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "This planner differs from others in the sense that it's not bound  by the clock. Rather, Charlotte Mason believed that learning should be a routine - a part of our daily living and not restricted by time. I hope you find this planner a tool that facilitates in structuring your day while giving you the freedom to learn and explore at your own pace!"
fit_content = true

[node name="ControlSpacer2" type="Control" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2

[node name="LabelInstructions" type="RichTextLabel" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Here's a quick overview to get you started!
1. In the Settings tab, add your students.
2. In the Resource tab, you can add, view, edit, and delete your resources (e.g., books, digital media, etc...).
3. From the selected Resource, you can then schedule it for your student
4. In the Schedule tab. you can see all scheduled assignments
5. Finally, any assignments scheduled for today will appear here on the home page!"
fit_content = true
